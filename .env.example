# Port the server listens on. Render sets this automatically; only needed
# locally if you want something other than the default.
PORT=3000

# Local development: localhost is already allowed by the server. Leave this
# empty unless you want to explicitly enable the hostname allowlist locally.
PUBLIC_HOSTNAME=

# Render production value. Set this in Render's Environment settings, not in
# the local .env file. Use the hostname only: no https://, path, or slash.
# PUBLIC_HOSTNAME=diligence-ai-order-ops-mcp.onrender.com

# Required for every POST /mcp request, locally and in Render. Never commit
# the real value; set it in your local environment or the Render dashboard.
MCP_BEARER_TOKEN=
